@using System.Collections.Generic
@using System.Linq
@{
    var mockFleet = ViewBag.MockFleet ?? new List<dynamic>();
}

<div class="space-y-12">
    @{
        var screens = new[] { 
            new { id = "mainScreen", label = "Ana Sayfa Araçları" },
            new { id = "popularScreen1", label = "Popüler Liste 1" },
            new { id = "popularScreen2", label = "Popüler Liste 2" }
        };
    }
    
    @foreach(var screen in screens) {
        <div class="space-y-6">
            <div class="flex items-center justify-between">
                <h3 class="text-xl font-display font-bold text-white uppercase tracking-widest">@screen.label</h3>
                @{
                    var count = 0;
                    foreach(dynamic car in mockFleet) {
                        var propValue = car.GetType().GetProperty(screen.id)?.GetValue(car, null);
                        if(propValue is bool && (bool)propValue) {
                            count++;
                        }
                    }
                }
                <span class="text-[10px] text-emerald-500 font-bold px-3 py-1 bg-emerald-500/10 rounded-full border border-emerald-500/20">@count Araç</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                @{
                    var screenCars = new List<dynamic>();
                    foreach(dynamic car in mockFleet) {
                        var propValue = car.GetType().GetProperty(screen.id)?.GetValue(car, null);
                        if(propValue is bool && (bool)propValue) {
                            screenCars.Add(car);
                        }
                    }
                }
                
                @if(screenCars.Count > 0) {
                    @foreach(var car in screenCars) {
                        <div class="bg-zinc-950 border border-zinc-800 rounded-[2.5rem] overflow-hidden group hover:border-zinc-700 transition-all">
                            <div class="aspect-[4/3] overflow-hidden relative">
                                <img src="@car.image" alt="@car.model" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                            </div>
                            <div class="p-6 space-y-4">
                                <p class="text-[9px] text-emerald-500 font-bold uppercase tracking-[0.2em] mb-1">@car.brand</p>
                                <h3 class="text-lg font-display font-black text-white truncate">@car.model</h3>
                                <form method="POST" action="@Url.Action("RemoveFromFeatured", "Admin")">
                                    <input type="hidden" name="carId" value="@car.id">
                                    <input type="hidden" name="screen" value="@screen.id">
                                    <button type="submit" class="w-full py-3 bg-red-500/10 border border-red-500/20 rounded-xl text-[10px] font-bold text-red-500 hover:bg-red-500 hover:text-white transition-all">
                                        Bu Bölümden Kaldır
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                } else {
                    <div class="col-span-full py-12 flex flex-col items-center justify-center text-center">
                        <p class="text-zinc-500 text-sm">Bu bölümde henüz araç yok.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>
