<div id="loginCard" class="relative z-10 w-full max-w-xl bg-white/80 backdrop-blur-xl rounded-[3.5rem] border border-white shadow-[0_32px_64px_-12px_rgba(0,0,0,0.1)] overflow-hidden p-10 md:p-14 transition-all duration-500" data-mode="login">
    
    <div class="text-center mb-12">
        <div class="text-3xl md:text-4xl font-display font-bold tracking-tighter text-brand-black mb-6">
            RENTOVA<span class="text-brand-anthracite">.</span>
        </div>
        <h2 id="loginTitle" class="text-4xl font-display font-bold text-brand-black mb-3">Hoş Geldiniz</h2>
        <p id="loginSubtitle" class="text-brand-anthracite/50 text-base">Premium sürüş deneyimine giriş yapın.</p>
    </div>

    <form id="authForm" class="space-y-5">
        <!-- Register Fields -->
        <div id="registerFields" class="hidden space-y-5 animate__animated animate__fadeIn">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div class="relative">
                    <svg class="absolute left-5 top-1/2 -translate-y-1/2 text-brand-anthracite/30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input type="text" id="firstName" placeholder="Ad" class="w-full bg-brand-light/50 border border-brand-gray/20 rounded-2xl py-5 pl-14 pr-5 text-sm text-brand-black outline-none focus:border-brand-black/20 focus:bg-white transition-all" />
                </div>
                <div class="relative">
                    <svg class="absolute left-5 top-1/2 -translate-y-1/2 text-brand-anthracite/30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    <input type="text" id="lastName" placeholder="Soyad" class="w-full bg-brand-light/50 border border-brand-gray/20 rounded-2xl py-5 pl-14 pr-5 text-sm text-brand-black outline-none focus:border-brand-black/20 focus:bg-white transition-all" />
                </div>
            </div>
            <div class="relative">
                <svg class="absolute left-5 top-1/2 -translate-y-1/2 text-brand-anthracite/30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <input type="tel" id="phoneNumber" placeholder="Telefon" class="w-full bg-brand-light/50 border border-brand-gray/20 rounded-2xl py-5 pl-14 pr-5 text-sm text-brand-black outline-none focus:border-brand-black/20 focus:bg-white transition-all" />
            </div>
        </div>

        <!-- Common Fields -->
        <div class="relative">
            <svg class="absolute left-5 top-1/2 -translate-y-1/2 text-brand-anthracite/30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2-2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <input type="email" id="email" placeholder="E-posta" class="w-full bg-brand-light/50 border border-brand-gray/20 rounded-2xl py-5 pl-14 pr-5 text-sm text-brand-black outline-none focus:border-brand-black/20 focus:bg-white transition-all" required />
        </div>
        <div class="relative">
            <svg class="absolute left-5 top-1/2 -translate-y-1/2 text-brand-anthracite/30" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <input type="password" id="password" placeholder="Şifre" class="w-full bg-brand-light/50 border border-brand-gray/20 rounded-2xl py-5 pl-14 pr-5 text-sm text-brand-black outline-none focus:border-brand-black/20 focus:bg-white transition-all" required />
        </div>

        <div id="authMessage" class="text-xs font-bold text-center h-4 opacity-0 transition-opacity duration-300"></div>

        <button type="submit" id="submitBtn" class="w-full py-6 bg-brand-black text-white rounded-2xl font-bold text-lg hover:bg-brand-anthracite transition-all mt-2 shadow-xl shadow-brand-black/10">
            Giriş Yap
        </button>
    </form>

    <div class="mt-10 relative">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-brand-gray/20"></div></div>
        <div class="relative flex justify-center text-xs uppercase tracking-widest font-bold"><span class="bg-white px-6 text-brand-anthracite/30">Veya</span></div>
    </div>

    <button id="socialAuthBtn" type="button" class="mt-10 w-full bg-white border border-brand-gray/20 text-brand-black rounded-2xl py-5 font-bold text-sm hover:bg-brand-light transition-all flex items-center justify-center gap-4 shadow-sm">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/></svg>
        Google ile <span id="googleBtnText">Giriş Yap</span>
    </button>

    <p class="mt-10 text-center text-sm text-brand-anthracite/50">
        <span id="footerText">Henüz hesabınız yok mu?</span>
        <button id="toggleModeBtn" class="text-brand-black font-bold hover:underline ml-1">Kayıt Olun</button>
    </p>
</div>
