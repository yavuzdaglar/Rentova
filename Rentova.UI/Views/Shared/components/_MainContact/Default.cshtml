<section id="contact" class="py-32 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
        <div class="bg-brand-black p-8 md:p-20 rounded-[4rem] border border-white/10 relative overflow-hidden">
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
                <div>
                    <h2 class="text-5xl md:text-6xl font-display font-bold text-white leading-tight mb-8">BİZE <br /><span class="text-brand-gray/40 italic">ULAŞIN</span></h2>
                    <p class="text-brand-gray/50 text-lg mb-12 max-w-md">Herhangi bir sorunuz mu var? Ekibimiz size yardımcı olmaktan mutluluk duyacaktır.</p>
                </div>
                <div class="bg-white/5 p-8 md:p-12 rounded-[3rem] border border-white/10 relative">
                    <div id="mainContactGuestState" class="hidden">
                        <p class="text-white text-3xl font-display font-bold mb-3">Lütfen giriş yapın</p>
                        <p class="text-brand-gray/50 text-sm mb-8">Panel erişimi için önce hesabınıza giriş yapmanız gerekiyor.</p>
                        <a href="@Url.Action("Index", "Login")" class="w-full flex items-center justify-center gap-2 py-5 bg-white text-brand-black rounded-2xl font-bold hover:bg-brand-gray transition-all">Giriş Yap</a>
                    </div>

                    <div id="mainContactAuthState" class="hidden">
                        <p class="text-white text-3xl font-display font-bold mb-3">Giriş algılandı</p>
                        <p class="text-brand-gray/50 text-sm mb-8">Hesabınızla devam edebilirsiniz. Aşağıdaki butondan panelinize geçebilirsiniz.</p>
                        <a id="mainContactPanelLink" href="/AccountMenu?tab=messages" class="w-full flex items-center justify-center gap-2 py-5 bg-white text-brand-black rounded-2xl font-bold hover:bg-brand-gray transition-all">Panele Git</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const guestState = document.getElementById('mainContactGuestState');
        const authState = document.getElementById('mainContactAuthState');
        const panelLink = document.getElementById('mainContactPanelLink');

        // Kullanici panel linki hazir oldugunda burada degistirilir.
        const panelUrl = '/AccountMenu?tab=messages';

        if (panelLink) {
            panelLink.setAttribute('href', panelUrl);
        }

        const userJson = localStorage.getItem('currentUser');
        const isLoggedIn = !!userJson;

        if (isLoggedIn) {
            if (guestState) guestState.classList.add('hidden');
            if (authState) authState.classList.remove('hidden');
            return;
        }

        if (authState) authState.classList.add('hidden');
        if (guestState) guestState.classList.remove('hidden');
    });
</script>
