@model Rentova.UI.Models.AccountMenu.AccountMenuPageViewModel

<section id="accountTabReservations" class="account-tab-panel is-active" data-tab-panel="reservations">
    <div class="account-panel-head">
        <h2 class="account-panel-title">Rezervasyonlarim</h2>
        <span id="accountReservationCountBadge" class="account-count-badge">Toplam @Model.Reservations.Count Kayit</span>
    </div>

    <p class="account-warning-note">
        Bilgilendirme: Bitmis olan rezervasyonlariniz bir sure sonra sistemden silinebilir.
    </p>

    <div id="accountDeleteConfirmToast" class="account-delete-confirm-toast" role="alert" aria-live="assertive">
        <p id="accountDeleteConfirmText" class="account-delete-confirm-text">Bu rezervasyonu silmek istediginize emin misiniz?</p>
        <div class="account-delete-confirm-actions">
            <button type="button" id="accountDeleteConfirmYes" class="account-delete-confirm-btn yes">Evet, Sil</button>
            <button type="button" id="accountDeleteConfirmNo" class="account-delete-confirm-btn no">Vazgec</button>
        </div>
    </div>

    <p id="accountReservationsMessage" class="account-inline-message @(string.IsNullOrWhiteSpace(Model.ReservationFeedback) ? string.Empty : "is-success")" aria-live="polite">@Model.ReservationFeedback</p>

    <div id="accountReservationsList" class="account-reservation-list">
        @if (!Model.Reservations.Any())
        {
            <div class="account-empty">Henuz rezervasyon kaydiniz bulunmuyor.</div>
        }
        else
        {
            foreach (var item in Model.Reservations)
            {
                var vehicleName = $"{item.BrandName} {item.CarModel}".Trim();
                var statusLabel = string.IsNullOrWhiteSpace(item.Status) ? "Aktif" : item.Status;
                var statusCode = statusLabel.Equals("Bitti", StringComparison.OrdinalIgnoreCase)
                    ? "completed"
                    : statusLabel.Equals("Beklemede", StringComparison.OrdinalIgnoreCase)
                        ? "upcoming"
                        : "active";

                <article class="account-reservation-card @(statusCode == "completed" ? "is-past" : string.Empty)">
                    <div class="account-reservation-image-wrap">
                        <img class="account-reservation-image" src="@item.CarImage" alt="@vehicleName" />
                    </div>
                    <div class="account-reservation-body">
                        <div class="account-reservation-top">
                            <h3 class="account-reservation-name">@vehicleName</h3>
                            <span class="account-status-badge account-status-@statusCode">@statusLabel</span>
                        </div>
                        <div class="account-reservation-meta">
                            <span>Baslangic: @item.StartDate.ToString("dd.MM.yyyy")</span>
                            <span>Bitis: @item.EndDate.ToString("dd.MM.yyyy")</span>
                            <span>Sure: @(item.TotalDays > 0 ? $"{item.TotalDays} gun" : "-")</span>
                            <span>Tutar: @item.Price.ToString("N0") TL</span>
                        </div>
                    </div>
                    <div class="account-reservation-actions">
                        <form method="post" action="@Url.Action("DeleteReservation", "AccountMenu")" class="account-reservation-delete-form" data-vehicle-name="@vehicleName">
                            <input type="hidden" name="reservationId" value="@item.ReservationId" />
                            <button type="submit" class="account-icon-btn delete account-reservation-delete-trigger" title="Rezervasyonu sil" aria-label="Rezervasyonu sil">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                    <path d="M10 11v6"></path>
                                    <path d="M14 11v6"></path>
                                    <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
                                </svg>
                            </button>
                        </form>
                        <a class="account-icon-btn go" href="/Reservation?carId=@item.CarId" title="Rezervasyon sayfasina git" aria-label="Rezervasyon sayfasina git">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>
                </article>
            }
        }
    </div>
</section>
