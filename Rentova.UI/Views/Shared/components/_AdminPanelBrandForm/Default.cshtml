@{
}

<div class="max-w-2xl mx-auto bg-zinc-950 border border-zinc-800 rounded-[3rem] p-12">
    <div class="flex items-center gap-6 mb-12">
        <div class="w-16 h-16 rounded-3xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-500">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
        </div>
        <div>
            <h2 class="text-3xl font-display font-black text-white">Yeni Marka Ekle</h2>
            <p class="text-zinc-500 text-sm">Sisteme yeni bir otomobil markası tanımlayın.</p>
        </div>
    </div>

    <form method="POST" action="@Url.Action("AddBrand", "Admin")" class="space-y-8">
        <div class="space-y-2">
            <label class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest ml-4">MARKA ADI</label>
            <input type="text" name="brandName" placeholder="Örn: Tesla" 
                class="w-full bg-zinc-900 border border-zinc-800 rounded-2xl py-4 px-6 text-sm text-white outline-none focus:border-emerald-500 transition-all" required />
        </div>
        <div class="space-y-2">
            <label class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest ml-4">MARKA LOGOSU (URL)</label>
            <input type="text" name="brandLogo" placeholder="https://..." 
                class="w-full bg-zinc-900 border border-zinc-800 rounded-2xl py-4 px-6 text-sm text-white outline-none focus:border-emerald-500 transition-all" required />
        </div>

        <div class="pt-8 flex items-center gap-3">
            <a href="@Url.Action("AdminPanel", "Admin", new { tab = "fleet" })"
               class="inline-flex items-center justify-center px-5 py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-xs font-bold text-zinc-400 hover:text-white transition-all">
                İptal
            </a>
            <button type="submit" class="flex-1 py-5 bg-emerald-500 text-black rounded-2xl text-sm font-black hover:bg-emerald-400 transition-all shadow-2xl shadow-emerald-500/20">Markayı Kaydet</button>
        </div>
    </form>
</div>
