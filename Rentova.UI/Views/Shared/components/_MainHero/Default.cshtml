@using Rentova.UI.Dtos.CarDtos
@model CarMainScreenDto

<section id="mainHeroSection" class="relative h-screen w-full overflow-hidden flex items-center">
    <div class="absolute inset-0 z-0">
        @if (Model != null && !string.IsNullOrEmpty(Model.CarImage))

        {
            <img src="@Model.CarImage" alt="@Model.CarModel" class="w-full h-full object-cover" />
        }

        else

        {
            <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&q=80&w=2000"
                alt="Hero Car" class="w-full h-full object-cover" />
        }
        <div class="absolute inset-0 bg-gradient-to-r from-white via-white/40 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
        <div class="max-w-2xl">
            <div class="opacity-100 transition-all duration-1000 transform translate-y-0">
                <span
                    class="inline-block px-4 py-1.5 bg-brand-black text-white text-[10px] font-bold uppercase tracking-widest rounded-full mb-6">
                    @if (Model != null)
                    {
                        @Model.BrandName @:- @Model.CarModel
                    }
                    else
                    {
                        @:Premium Araç Kiralama
                    }
                </span>
                <h1 class="hero-main-title text-7xl md:text-8xl font-display font-bold leading-[0.9] tracking-tighter mb-8">
                    GELECEĞİ <br />
                    <span class="hero-title-accent text-brand-anthracite">BUGÜN</span> SÜRÜN
                </h1>
                <p class="hero-main-description text-lg text-brand-anthracite max-w-md mb-10 leading-relaxed">
                    Lüks ve performansın zirvesini deneyimleyin. Rentova, dünyanın en prestijli araçlarından oluşan özel
                    bir filo sunar.
                </p>
                <div class="flex flex-wrap gap-4">
                    <a href="/Product"
                        class="bg-brand-black text-white px-8 py-4 rounded-full font-medium transition-all hover:bg-brand-anthracite hover:scale-105 active:scale-95 flex items-center gap-2 group">
                        Filoyu Keşfet
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="group-hover:translate-x-1 transition-transform">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
