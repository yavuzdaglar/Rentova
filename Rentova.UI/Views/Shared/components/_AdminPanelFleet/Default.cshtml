@using System.Collections.Generic
@using System.Linq
@{
    var mockFleet = ViewBag.MockFleet ?? new List<dynamic>();
    var fleetSearch = ViewBag.FleetSearch as string ?? "";
    var fleetPage = ViewBag.FleetPage ?? 1;
    var itemsPerPage = 20;
    
    var filteredFleet = new List<dynamic>();
    foreach(dynamic car in mockFleet) {
        var fullName = $"{car.brand} {car.model}".ToLower();
        if(fullName.Contains(fleetSearch.ToLower())) {
            filteredFleet.Add(car);
        }
    }
    
    var startIdx = (int.Parse(fleetPage.ToString()) - 1) * itemsPerPage;
    var pagedFleet = new List<dynamic>();
    for(int i = startIdx; i < filteredFleet.Count && i < startIdx + itemsPerPage; i++) {
        pagedFleet.Add(filteredFleet[i]);
    }
    
    var totalPages = Math.Ceiling((double)filteredFleet.Count / itemsPerPage);
}

<div class="space-y-8">
    <div class="flex flex-col md:flex-row gap-6 items-center justify-between bg-zinc-950 border border-zinc-800 p-8 rounded-[2.5rem]">
        <div class="relative flex-1 w-full">
            <svg class="absolute left-6 top-1/2 -translate-y-1/2 text-zinc-500 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path>
            </svg>
            <form method="GET" action="@Url.Action("AdminPanel", "Admin")">
                <input type="hidden" name="tab" value="fleet">
                <input type="text" name="search" placeholder="Araç ismi ile ara..." 
                    value="@fleetSearch"
                    class="w-full bg-zinc-900 border border-zinc-800 rounded-2xl py-4 pl-16 pr-8 text-sm text-white outline-none focus:border-emerald-500 transition-all">
            </form>
        </div>
        <div class="flex gap-4 w-full md:w-auto">
            <form method="GET" action="@Url.Action("AdminPanel", "Admin")" style="display:inline;">
                <input type="hidden" name="tab" value="add-car">
                <button type="submit" class="flex-1 md:flex-none px-8 py-4 bg-emerald-500 text-black rounded-2xl text-xs font-bold hover:bg-emerald-400 transition-all">Yeni Araç</button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        @foreach(var car in pagedFleet) {
            <div class="bg-zinc-950 border border-zinc-800 rounded-[2.5rem] overflow-hidden group hover:border-zinc-700 transition-all">
                <div class="aspect-[4/3] overflow-hidden relative">
                    <img src="@car.image" alt="@car.model" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                </div>
                <div class="p-6 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="text-[9px] text-emerald-500 font-bold uppercase tracking-[0.2em] mb-1">@car.brand</p>
                            <h3 class="text-lg font-display font-black text-white truncate">@car.model</h3>
                        </div>
                        <div class="text-right">
                            <p class="text-[11px] text-emerald-500 font-black whitespace-nowrap">@car.price</p>
                            <p class="text-[9px] text-zinc-500 font-bold">/ Gunluk</p>
                        </div>
                    </div>
                    
                    <div class="pt-4 border-t border-zinc-800/50 grid grid-cols-2 gap-3">
                        <div>
                            <p class="text-[8px] uppercase tracking-widest text-zinc-600 font-bold">Yakit</p>
                            <p class="text-[10px] text-zinc-300 font-semibold">@car.fuel</p>
                        </div>
                        <div>
                            <p class="text-[8px] uppercase tracking-widest text-zinc-600 font-bold">Koltuk</p>
                            <p class="text-[10px] text-zinc-300 font-semibold">@car.seats</p>
                        </div>
                        <div>
                            <p class="text-[8px] uppercase tracking-widest text-zinc-600 font-bold">Vites</p>
                            <p class="text-[10px] text-zinc-300 font-semibold">@car.transmission</p>
                        </div>
                        <div>
                            <p class="text-[8px] uppercase tracking-widest text-zinc-600 font-bold">Arac Turu</p>
                            <p class="text-[10px] text-zinc-300 font-semibold">@car.vehicleType</p>
                        </div>
                    </div>

                    <div class="pt-4 flex gap-2">
                        <form method="GET" action="@Url.Action("AdminPanel", "Admin")" style="display:inline;" class="flex-1">
                            <input type="hidden" name="tab" value="add-car">
                            <input type="hidden" name="carId" value="@car.id">
                            <button type="submit" class="w-full py-3 bg-zinc-900 border border-zinc-800 rounded-xl text-[10px] font-bold text-white hover:bg-zinc-800 transition-all flex items-center justify-center gap-2">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                                Düzenle
                            </button>
                        </form>
                        <form method="POST" action="@Url.Action("DeleteCar", "Admin")" style="display:inline;">
                            <input type="hidden" name="id" value="@car.id">
                            <button type="submit" class="p-3 bg-zinc-900 border border-zinc-800 rounded-xl text-zinc-500 hover:text-red-500 transition-all">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if(totalPages > 1) {
        <div class="flex justify-center gap-2">
            @for(int i = 1; i <= totalPages; i++) {
                <form method="GET" action="@Url.Action("AdminPanel", "Admin")" style="display:inline;">
                    <input type="hidden" name="tab" value="fleet">
                    <input type="hidden" name="search" value="@fleetSearch">
                    <input type="hidden" name="page" value="@i">
                    <button type="submit" class="w-10 h-10 rounded-xl font-bold text-xs transition-all @(int.Parse(fleetPage.ToString()) == i ? "bg-emerald-500 text-black" : "bg-zinc-900 text-zinc-500 hover:text-white")">@i</button>
                </form>
            }
        </div>
    }
</div>
