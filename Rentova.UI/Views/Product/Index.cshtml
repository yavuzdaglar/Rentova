@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rentova - Araç Listesi</title>
    <link rel="stylesheet" href="~/css/main.css" />
    <link rel="stylesheet" href="~/css/account-menu.css" />
    <link rel="stylesheet" href="~/css/product.css" />
    <link rel="stylesheet" href="~/css/theme-toggle.css" />
    <link rel="stylesheet" href="~/css/ai-chat.css" />
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('rentova-theme');
                document.documentElement.setAttribute('data-theme', savedTheme === 'light' ? 'light' : 'dark');
            } catch (_error) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white text-brand-black font-sans antialiased selection:bg-brand-black selection:text-white">
    <div id="root">
        @await Component.InvokeAsync("_ProductNavbar")
        
        <main class="pt-32 pb-20 px-6 max-w-7xl mx-auto">
            @await Component.InvokeAsync("_ProductSearch")
            @await Component.InvokeAsync("_ProductFilters")
            @await Component.InvokeAsync("_ProductCarGrid")
        </main>

        @await Component.InvokeAsync("_ProductFooter")
    </div>
    <script src="~/js/auth.js"></script>
    <script src="~/js/theme-toggle.js"></script>
    <script src="~/js/ai-chat.js"></script>
    <script src="~/js/product.js"></script>
</body>
</html>
